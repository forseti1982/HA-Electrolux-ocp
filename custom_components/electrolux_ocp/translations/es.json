          "refresh_token": "Refresh Token"
        },
        "data_description": {
          "api_key": "La misma de antes (o una nueva desde « API Keys »).",
          "access_token": "El token de corta duración del nuevo par.",
          "refresh_token": "El token largo del nuevo par."
        }
      }
    },
