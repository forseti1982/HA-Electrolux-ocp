{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(python -m compileall:*)",
      "Bash(python3 -m compileall:*)",
      "Bash(node --check:*)",
      "Read(./custom_components/**)",
      "Read(./.claude/**)"
    ],
    "deny": [
      "Read(./**/secrets.yaml)",
      "Read(./**/.storage/**)",
      "Read(./**/*.env)"
    ]
  }
}
